#!/bin/bash
#SBATCH --time=48:00:00
#SBATCH --mail-type=END
#SBATCH --output=/scratch1/tanxinli/output/3.vep_%A_%a.out
#SBATCH --error=/scratch1/tanxinli/error/3.vep_%A_%a.errcd
#SBATCH --job-name=vep
#SBATCH -c 15
#SBATCH --ntasks=1
#SBATCH --mem=50G
#SBATCH --partition=main
#SBATCH --account=desmith_128
#SBATCH --array=1-5

module purge
eval "$(conda shell.bash hook)"
module load gcc/11.3.0  openblas/0.3.20
conda activate vep

cd /project/desmith_128/tanxin/scratch2/tumoroutput/batch2/BCFtools.filter.tumoronly.autosomal
ref=/project/desmith_488/kerenxu/refs/GATK_resource_bundle/resources_broad_hg38_v0_Homo_sapiens_assembly38.fasta
input_dir=/project/desmith_128/tanxin/scratch2/tumoroutput/batch2/BCFtools.filter.tumoronly.autosomal
output_dir=/project/desmith_128/tanxin/scratch2/tumoroutput/batch2/BCFtools.filter.tumoronly.autosomal/vep

input_vcf=(`ls *funcotated.bcftools.tumoronly.chr1to22.vcf | sed -n ${SLURM_ARRAY_TASK_ID}p`)

base=$(basename ${input_vcf} .funcotated.bcftools.tumoronly.chr1to22.vcf)
prefix="sample"
sample_name=${base#"$prefix"}
output_vcf=${sample_name}.vep.vcf

#vep --input_file $input_vcf  --dir /project/desmith_488/tanxinli/vep/GRCh38/vep   --cache --fork=4   --assembly GRCh38   --fasta $ref   --format vcf   --vcf   --output_file ${output_dir}/$output_vcf   --force_overwrite

vep \
  --species homo_sapiens \
  --assembly GRCh38 --offline \
  --dir /project/desmith_488/tanxinli/vep/GRCh38/vep \
  --fasta $ref \
  --input_file $input_vcf \
  --output_file /project/desmith_128/tanxin/scratch2/tumoroutput/batch2/BCFtools.filter.tumoronly.autosomal/vep/$output_vcf \
  --everything \
  --fork 20 \
  --cache \
  --vcf
