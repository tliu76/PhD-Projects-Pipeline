#!/bin/bash
#SBATCH --time=48:00:00
#SBATCH --mail-type=END
#SBATCH --output=/scratch1/tanxinli/output/2.1.5MergeStats_%A_%a.out
#SBATCH --error=/scratch1/tanxinli/error/2.1.5MergeStats_%A_%a.errcd
#SBATCH --job-name=2.1.5MergeStats
#SBATCH -c 15
#SBATCH --ntasks=1
#SBATCH --mem=10G
#SBATCH --partition=main
#SBATCH --array=1-6

module load gcc/11.3.0
module load openjdk
module load gatk/4.2.6.1

cd /scratch1/tanxinli/tumoroutput/batch3/mutect2_out/scatter0/
ref=/project/desmith_488/kerenxu/refs/GATK_resource_bundle/resources_broad_hg38_v0_Homo_sapiens_assembly38.fasta

## input:
input_stats=($(ls *.vcf.gz.stats | sed -n ${SLURM_ARRAY_TASK_ID}p))
base=$(basename ${input_stats} .vcf.gz.stats)
prefix="sample"
sample_name=${base#"$prefix"}

## output:
output_stats="$base.vcf.gz.stats"

## change directory:
cd /scratch1/tanxinli/tumoroutput/batch3/mutect2_out/
## merge:
srun gatk --java-options "-Xms5G" \
    MergeMutectStats \
    -stats ./scatter0/$input_stats \
    -stats ./scatter1/$input_stats \
    -stats ./scatter2/$input_stats \
    -stats ./scatter3/$input_stats \
    -stats ./scatter4/$input_stats \
    -O ./gather/$output_stats

