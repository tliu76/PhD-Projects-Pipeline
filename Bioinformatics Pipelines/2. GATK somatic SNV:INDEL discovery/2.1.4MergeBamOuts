#!/bin/bash
#SBATCH --time=48:00:00
#SBATCH --mail-type=END
#SBATCH --output=/scratch1/tanxinli/output/2.1.4MergeBamOuts_%A_%a.out
#SBATCH --error=/scratch1/tanxinli/error/2.1.4MergeBamOuts_%A_%a.errcd
#SBATCH --job-name=2.1.4MergeBamOuts
#SBATCH -c 15
#SBATCH --ntasks=1
#SBATCH --mem=70G
#SBATCH --partition=main
#SBATCH --array=1-6


module load gcc/11.3.0
module load openjdk
module load gatk/4.2.6.1

cd /scratch1/tanxinli/tumoroutput/batch3/mutect2_out/scatter0
ref=/project/desmith_488/tanxinli/refs/GATK_resource_bundle/resources_broad_hg38_v0_Homo_sapiens_assembly38.fasta
## input:
input_bam=($(ls *.tumor_normal.bam | sed -n ${SLURM_ARRAY_TASK_ID}p))
base=$(basename ${input_bam} .tumor_normal.bam)
prefix="sample"
sample_name=${base#"$prefix"}
## output:
unsorted_out_bam="$base.tumor_normal.unsorted.out.bam"
output_bam="$base.tumor_normal.bam"

## change directory:
cd /scratch1/tanxinli/tumoroutput/batch3/mutect2_out/gather
#the tumor_normal.bai will be saved in "gather" folder
## merge:
srun gatk --java-options "-Xms55G -Djava.io.tmpdir=/scratch1/tanxinli/tmp/MergeBamOuts" \
    GatherBamFiles \
    -I /scratch1/tanxinli/tumoroutput/batch3/mutect2_out/scatter0/$input_bam \
    -I /scratch1/tanxinli/tumoroutput/batch3/mutect2_out/scatter1/$input_bam \
    -I /scratch1/tanxinli/tumoroutput/batch3/mutect2_out/scatter2/$input_bam \
    -I /scratch1/tanxinli/tumoroutput/batch3/mutect2_out/scatter3/$input_bam \
    -I /scratch1/tanxinli/tumoroutput/batch3/mutect2_out/scatter4/$input_bam \
    -O /scratch1/tanxinli/tumoroutput/batch3/mutect2_out/gather/$unsorted_out_bam \
    -R $ref \
    --TMP_DIR /scratch1/tanxinli/tmp/MergeBamOuts


srun gatk --java-options "-Xms55G -Djava.io.tmpdir=/scratch1/tanxinli/tmp/MergeBamOuts" \
    SortSam \
    -I /scratch1/tanxinli/tumoroutput/batch3/mutect2_out/gather/$unsorted_out_bam \
    -O /scratch1/tanxinli/tumoroutput/batch3/mutect2_out/gather/$output_bam \
    --SORT_ORDER coordinate \
    -VALIDATION_STRINGENCY LENIENT \
    --TMP_DIR /scratch1/tanxinli/tmp/MergeBamOuts

srun gatk --java-options "-Xms55G -Djava.io.tmpdir=/scratch1/tanxinli/tmp/MergeBamOuts" \
    BuildBamIndex \
    -I /scratch1/tanxinli/tumoroutput/batch3/mutect2_out/gather/$output_bam \
    -VALIDATION_STRINGENCY LENIENT \
    --TMP_DIR /scratch1/tanxinli/tmp/MergeBamOuts


