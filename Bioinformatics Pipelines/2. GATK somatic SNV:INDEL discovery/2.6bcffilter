#!/bin/bash
#SBATCH --time=01:00:00
#SBATCH --mail-type=END
#SBATCH --output=/scratch1/tanxinli/output/2.6filter_%A_%a.out
#SBATCH --error=/scratch1/tanxinli/error/2.6filter_%A_%a.errcd
#SBATCH --job-name=2.6bcffilter
#SBATCH -c 15
#SBATCH --ntasks=1
#SBATCH --mem=60G
#SBATCH --partition=main
#SBATCH --account=desmith_128

module load gcc/11.3.0 openblas/0.3.20
module load openjdk
module load gatk/4.2.6.1
module load bcftools/1.14
module load htslib 



cd /project/desmith_128/recordstudy/batch3/Funcotator_out


for f in *.vcf.gz; do
   bgzip -d "$f"
done

for i in {1..6}; do
  echo "Welcome $i times"
  input_vcf=(`ls *.funcotated.vcf.gz | sed -n ${i}p`)
  echo ${input_vcf}
  base=$(basename ${input_vcf} .funcotated.vcf.gz)
  #prefix="sample"
  #sample_name=${base#"$prefix"}
  tumor_sample_name="${base}"
  output_vcf=${base}.funcotated.bcftools.tumoronly.vcf.gz
  bcftools view $input_vcf -Ou -i 'FILTER=="PASS"' | \
  bcftools view -Ou -i 'FMT/DP[0]>=10' | bcftools view -Ou -i 'FMT/DP[1]>=14' | \
  bcftools view -Ou -i '(FORMAT/AD[*:1]/FORMAT/DP)>=0.1' | bcftools view -s $tumor_sample_name \
  -o ../BCFtools.filter.tumoronly/$output_vcf -O z --threads 15
done

cd /project/desmith_128/recordstudy/batch3/BCFtools.filter.tumoronly
for i in {1..6}; do
  echo "welcom $i times" 
  input_vcf=(`ls *.vcf.gz | sed -n ${i}p`)
  echo ${input_vcf}
  tabix -f ${input_vcf}
  output_vcf=$(basename ${input_vcf} .funcotated.bcftools.tumoronly.vcf.gz).funcotated.bcftools.tumoronly.chr1to22.vcf.gz
  bcftools view $input_vcf -Ou --regions chr1,chr2,chr3,chr4,chr5,chr6,chr7,chr8,chr9,\
  chr10,chr11,chr12,chr13,chr14,chr15,chr16,chr17,chr18,chr19,chr20,chr21,chr22 \
  -o ../BCFtools.filter.tumoronly.autosomal/$output_vcf -O z --threads 15
done


