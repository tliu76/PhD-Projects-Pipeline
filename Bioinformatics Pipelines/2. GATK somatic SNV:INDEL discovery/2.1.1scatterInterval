#!/bin/bash
#SBATCH --time=01:00:00
#SBATCH --mail-type=END
#SBATCH --output=/scratch1/tanxinli/output/splitinterval_%A_%a.out
#SBATCH --error=/scratch1/tanxinli/error/splitinterval_%A_%a.errcd
#SBATCH --job-name=splitinterval
#SBATCH -c 15
#SBATCH --ntasks=1
#SBATCH --mem=59G
#SBATCH --partition debug

module load gcc/11.3.0
module load openjdk
module load gatk/4.2.6.1

cd /project/desmith_488/tanxinli/refs/GATK_resource_bundle/interval_file/
ref=/project/desmith_488/tanxinli/refs/GATK_resource_bundle/Homo_sapiens_assembly38.fasta  
interval_list=/project/desmith_488/tanxinli/refs/GATK_resource_bundle/wgs_calling_regions.hg38.interval_list
#interval_list is the same as in the base recalibration step
srun gatk --java-options "-Xms55G" \
    SplitIntervals \
    -R $ref \
    -L $interval_list \
    -scatter-count 5 \
    -O interval_files


