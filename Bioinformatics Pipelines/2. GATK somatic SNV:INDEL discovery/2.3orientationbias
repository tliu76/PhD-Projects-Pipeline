#!/bin/bash
#SBATCH --time=48:00:00
#SBATCH --mail-type=END
#SBATCH --output=/scratch1/tanxinli/output/2.3OrientationBias_%A_%a.out
#SBATCH --error=/scratch1/tanxinli/error/2.3OrientationBias_%A_%a.errcd
#SBATCH --job-name=2.3OrientationBias
#SBATCH -c 20
#SBATCH --ntasks=1
#SBATCH --mem=60G
#SBATCH --partition=main
#SBATCH --array=1-6
#SBATCH --account=desmith_488

module load gcc/11.3.0
module load openjdk
module load gatk/4.2.6.1

cd /scratch1/tanxinli/tumoroutput/batch3/mutect2_out/scatter0
input_f1r2_tar_gz=($(ls *.f1r2.tar.gz | sed -n ${SLURM_ARRAY_TASK_ID}p))
base=$(basename ${input_f1r2_tar_gz} .f1r2.tar.gz)
#base=sample...
## output:
output_f1r2_tar_gz="$base.artifact-priors.tar.gz"

## run:

srun gatk --java-options "-Xms55G -Djava.io.tmpdir=/scratch1/tanxinli/tmp/orientationbias" \
    LearnReadOrientationModel \
    -I /scratch1/tanxinli/tumoroutput/batch3/mutect2_out/scatter0/$input_f1r2_tar_gz \
    -I /scratch1/tanxinli/tumoroutput/batch3/mutect2_out/scatter1/$input_f1r2_tar_gz \
    -I /scratch1/tanxinli/tumoroutput/batch3/mutect2_out/scatter2/$input_f1r2_tar_gz \
    -I /scratch1/tanxinli/tumoroutput/batch3/mutect2_out/scatter3/$input_f1r2_tar_gz \
    -I /scratch1/tanxinli/tumoroutput/batch3/mutect2_out/scatter4/$input_f1r2_tar_gz \
    -O /scratch1/tanxinli/tumoroutput/batch3/mutect2_out/gather/$output_f1r2_tar_gz \
    --tmp-dir /scratch1/tanxinli/tmp/orientationbias

