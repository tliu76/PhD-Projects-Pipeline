#!/bin/bash
#SBATCH --time=48:00:00
#SBATCH --mail-type=END
#SBATCH --output=/scratch1/tanxinli/output/1.1Tfastq2ubam_%A_%a.out
#SBATCH --error=/scratch1/tanxinli/error/1.1Tfastq2ubam_%A_%a.out
#SBATCH --job-name=1.1Tfastq2ubam
#SBATCH -c 20
#SBATCH --ntasks=1
#SBATCH --mem=50G
#SBATCH --partition=main
#SBATCH --array=1-15


module load gcc/11.3.0
module load openjdk
module load gatk/4.2.6.1

cd /project/desmith_128/recordstudy

## input: 

paths=$(awk '{print $1; print $2}' batch3list)
fastq1=(`find $paths  -name "*_1.fq.gz" | sed -n ${SLURM_ARRAY_TASK_ID}p`)
dir=$(dirname ${fastq1})
base=$(basename ${fastq1} _1.fq.gz)
fastq2=(`echo $fastq1 | sed 's/_1.fq.gz/_2.fq.gz/g'`)

sample_name=$(basename ${dir})

library_name=(`echo $base | cut -d '_' -f3`)
flowcell=(`echo $base | cut -d '_' -f1`)
lane1=(`echo $base | cut -d '_' -f2`)
lane=${lane1: -1}

readgroup_name="$sample_name"."$flowcell"."$lane"
platform_unit="$flowcell"."$lane"
platform_name=ILLUMINA

## output:
output_unmapped_bam="$sample_name"_"$base.unmapped.unsorted.bam"
out_dir="/project/desmith_128/recordstudy/batch3/unmapped.bam"

gatk --java-options "-Xms25G -Djava.io.tmpdir=/scratch1/tanxinli/tmp/fastq2bam" \
    FastqToSam \
    --FASTQ $fastq1 \
    --FASTQ2 $fastq2 \
    --OUTPUT $out_dir/$output_unmapped_bam \
    --READ_GROUP_NAME $readgroup_name \
    --SAMPLE_NAME $sample_name \
    --LIBRARY_NAME $library_name \
    --PLATFORM_UNIT $platform_unit \
    --PLATFORM $platform_name \
    --TMP_DIR /scratch1/tanxinli/tmp/fastq2bam


