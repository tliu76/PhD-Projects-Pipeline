#!/bin/bash
#SBATCH --time=48:00:00
#SBATCH --mail-type=ALL
#SBATCH --output=/scratch1/tanxinli/output/1.5.1TBqsr_%A_%a.out
#SBATCH --error=/scratch1/tanxinli/error/1.5.1TBqsr_%A_%a.errcd
#SBATCH --job-name=1.5.1TBqsr
#SBATCH -c 20
#SBATCH --ntasks=1
#SBATCH --mem=100G
#SBATCH --partition=epyc-64
#SBATCH --array=1-16
#SBATCH --account=desmith_488

export PATH="/project/desmith_488/tanxinli/tools/r_libs/common/:$PATH"

module load gcc/11.3.0 openblas/0.3.20
module load openjdk
module load gatk/4.2.6.1
module load r/4.2.1

cd /scratch1/tanxinli/tumoroutput/bqsr.bam
ref=/project/desmith_488/kerenxu/refs/GATK_resource_bundle/resources_broad_hg38_v0_Homo_sapiens_assembly38.fasta    
interval_list=/project/desmith_488/tanxinli/refs/GATK_resource_bundle/wgs_calling_regions.hg38.interval_list


## caution: some vcf.gz automatically becomes vcf after downloading from GCP, change the name from vcf to vcf.gz

## input:
input_bam=(`ls *.aligned.duplicates_marked.recalibrated.bam | sed -n ${SLURM_ARRAY_TASK_ID}p`)
base=$(basename ${input_bam} .aligned.duplicates_marked.recalibrated.bam)
recalibration_report_pre="$base.recal_data.csv"

## output: 
recalibration_report="$base.post.recal_data.csv"
OUTCSV="$base.AnalyzeCovariates.csv"
PLOT="$base.AnalyzeCovariates.pdf"


# Do a second pass to analyze covariation remaining after recalibration 

srun gatk --java-options "-Xms50G -Djava.io.tmpdir=/scratch2/tanxinli/tmp/bqsrplot" \
      BaseRecalibrator \
      -R $ref \
      -I $input_bam \
      -O $recalibration_report \
     --known-sites /project/desmith_488/tanxinli/refs/GATK_resource_bundle/Homo_sapiens_assembly38.dbsnp138.vcf \
      --known-sites /project/desmith_488/tanxinli/refs/GATK_resource_bundle/1000G_phase1.snps.high_confidence.hg38.vcf.gz \
      --known-sites /project/desmith_488/tanxinli/refs/GATK_resource_bundle/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz \
      --known-sites  /project/desmith_488/tanxinli/refs/GATK_resource_bundle/Homo_sapiens_assembly38.known_indels.vcf.gz \
      -L $interval_list \
      --tmp-dir /scratch2/tanxinli/tmp/bqsrplot
# Generate before/after plots
cd /scratch2/tanxinli/tumoroutput/batch2/bqsr.bam
srun gatk --java-options "-Xms55G -Djava.io.tmpdir=/scratch2/tanxinli/tmp/bqsrplot" \
      AnalyzeCovariates \
      --before $recalibration_report_pre \
      --after $recalibration_report \
      --plots $PLOT \
      --csv $OUTCSV \
      --tmp-dir /scratch2/tanxinli/tmp/bqsrplot

