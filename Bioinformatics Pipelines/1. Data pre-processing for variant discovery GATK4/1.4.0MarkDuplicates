#!/bin/bash
#SBATCH --time=48:00:00
#SBATCH --mail-type=END
#SBATCH --output=/scratch1/tanxinli/output/1.4TMarkDuplicates_%A_%a.out
#SBATCH --error=/scratch1/tanxinli/error/1.4TMarkDuplicates_%A_%a.errcd
#SBATCH --job-name=1.4TMarkDuplicates
#SBATCH -c 20
#SBATCH --ntasks=1
#SBATCH --mem=80G
#SBATCH --partition=main
#SBATCH --array=1-6
#SBATCH --account=desmith_128

module load gcc/11.3.0 
module load openjdk
module load gatk/4.2.6.1

cd /project/desmith_128/recordstudy/batch3/merged.bam

# id list : 
# input 
sample_name=(`cat /project/desmith_128/recordstudy/batch3/merged.bam/id_list4  | sed -n ${SLURM_ARRAY_TASK_ID}p`)
input_bam=$(ls ${sample_name}*.bam)
input_bam_prefix=$(printf " --INPUT %s" $input_bam)
prefix=" --INPUT "
input_bam_list=${input_bam_prefix#"$prefix"}

## output:
output_bam="$sample_name.aligned.unsorted.duplicates_marked.bam"
metrics_filename="$sample_name.duplicate_metrics"

srun gatk --java-options "-Xms50G  -Djava.io.tmpdir=/scratch1/tanxinli/tmp/markdup" \
      MarkDuplicates \
      --INPUT /project/desmith_128/recordstudy/batch3/merged.bam/$input_bam_list \
      --OUTPUT /scratch1/tanxinli/tumoroutput/batch3/markduplicates/$output_bam \
      --METRICS_FILE /scratch1/tanxinli/tumoroutput/batch3/markduplicates/$metrics_filename \
      --VALIDATION_STRINGENCY SILENT \
      --ASSUME_SORT_ORDER coordinate \
      --CREATE_MD5_FILE true \
      --TMP_DIR /scratch1/tanxinli/tmp/markdup



