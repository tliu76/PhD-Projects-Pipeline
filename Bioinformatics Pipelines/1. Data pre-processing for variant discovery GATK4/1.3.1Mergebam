#!/bin/bash
#SBATCH --time=48:00:00
#SBATCH --mail-type=ALL
#SBATCH --output=/scratch1/tanxinli/output/1.3Tmergebam_%A_%a.out
#SBATCH --error=/scratch1/tanxinli/error/1.3Tmergebam_%A_%a.errcd
#SBATCH --job-name=1.3Tmergebam
#SBATCH -c 20
#SBATCH --ntasks=1
#SBATCH --mem=69G
#SBATCH --partition=main
#SBATCH --array=1-11
#SBATCH --account=desmith_488

module load gcc/11.3.0 
module load openjdk
module load gatk/4.2.6.1

cd /scratch1/tanxinli/tumoroutput/batch3/sorted.aligned.bam
ref=/project/desmith_488/kerenxu/refs/GATK_resource_bundle/resources_broad_hg38_v0_Homo_sapiens_assembly38.fasta

#unmapped_bam=(`ls *.sorted.unmapped.bam | sed -n ${SLURM_ARRAY_TASK_ID}p`)
#base=$(basename ${unmapped_bam} .sorted.unmapped.bam)
#aligned_bam="$base.sorted.aligned.bam"
#output_bam="$base.bam"

aligned_bam=(`cat /scratch1/tanxinli/tumoroutput/batch3/sorted.aligned.bam/idlist.txt | sed -n ${SLURM_ARRAY_TASK_ID}p`)
base=$(basename ${aligned_bam} .sorted.aligned.bam)
unmapped_bam="$base.sorted.unmapped.bam"
output_bam="$base.bam"
gatk --java-options "-Xms50G -Djava.io.tmpdir=/scratch1/tanxinli/tmp/mergebam2" \
      MergeBamAlignment \
      --VALIDATION_STRINGENCY SILENT \
      --EXPECTED_ORIENTATIONS FR \
      --ATTRIBUTES_TO_RETAIN X0 \
      --ALIGNED_BAM /scratch1/tanxinli/tumoroutput/batch3/sorted.aligned.bam/$aligned_bam \
      --UNMAPPED_BAM /scratch1/tanxinli/tumoroutput/batch3/sorted.unmapped.bam/$unmapped_bam \
      --OUTPUT /project/desmith_128/recordstudy/batch3/merged.bam/$output_bam \
      --REFERENCE_SEQUENCE $ref \
      --PAIRED_RUN true \
      --SORT_ORDER coordinate \
      --IS_BISULFITE_SEQUENCE false \
      --ALIGNED_READS_ONLY false \
      --CLIP_ADAPTERS false \
      --MAX_RECORDS_IN_RAM 2000000 \
      --ADD_MATE_CIGAR true \
      --MAX_INSERTIONS_OR_DELETIONS -1 \
      --PRIMARY_ALIGNMENT_STRATEGY MostDistant \
      --PROGRAM_RECORD_ID "bwamem" \
      --PROGRAM_GROUP_VERSION "0.7.17-r1188" \
      --PROGRAM_GROUP_COMMAND_LINE "bwa mem $ref -t 20" \
      --PROGRAM_GROUP_NAME "bwamem" \
      --UNMAPPED_READ_STRATEGY COPY_TO_TAG \
      --ALIGNER_PROPER_PAIR_FLAGS true \
      --UNMAP_CONTAMINANT_READS true \
      --TMP_DIR /scratch1/tanxinli/tmp/mergebam2/

