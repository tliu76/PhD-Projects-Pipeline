#!/bin/bash
#SBATCH --time=48:00:00
#SBATCH --mail-type=END
#SBATCH --output=/scratch1/tanxinli/output/1.3.2Gvalidatembam_%A_%a.out
#SBATCH --error=/scratch1/tanxinli/error/1.3.2Gvalidatembam_%A_%a.errcd
#SBATCH --job-name=1.3.2Tvalidatembam
#SBATCH -c 20
#SBATCH --ntasks=1
#SBATCH --mem=50G
#SBATCH --partition=epyc-64
#SBATCH --array=1-2



module load gcc/11.3.0 
module load openjdk
module load gatk/4.2.6.1

cd /project/desmith_128/recordstudy/batch3/merged.bam 
# input 
input_bam=(`ls *.bam | sed -n ${SLURM_ARRAY_TASK_ID}p`)

srun gatk --java-options "-Xmx45G -Djava.io.tmpdir=/scratch1/tanxinli/tmp/validatebam" \
    ValidateSamFile \
    --INPUT /project/desmith_128/recordstudy/batch3/merged.bam/$input_bam \
    --IGNORE_WARNINGS true\
    --MODE VERBOSE \
    --TMP_DIR /scratch1/tanxinli/tmp/validatebam

