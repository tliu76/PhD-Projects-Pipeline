#!/bin/bash
#SBATCH --time=48:00:00
#SBATCH --mail-type=ALL
#SBATCH --output=/scratch1/tanxinli/output/1.52TBaseRecalibrator_%A_%a.out
#SBATCH --error=/scratch1/tanxinli/error/1.52TBaseRecalibrator_%A_%a.errcd
#SBATCH --job-name=1.5.2TBaseRecalibrator
#SBATCH -c 20
#SBATCH --ntasks=2
#SBATCH --mem=120G
#SBATCH --partition=epyc-64
#SBATCH --array=1-12
#SBATCH --account=desmith_488

module load gcc/11.3.0
module load openjdk
module load gatk/4.2.6.1

cd /project/desmith_128/recordstudy/batch3/SortAndFixTags
ref=/project/desmith_488/kerenxu/refs/GATK_resource_bundle/resources_broad_hg38_v0_Homo_sapiens_assembly38.fasta 

interval_list=/project/desmith_488/tanxinli/refs/GATK_resource_bundle/wgs_calling_regions.hg38.interval_list

## input:
input_bam=(`ls *.aligned.duplicate_marked.sorted.bam | sed -n ${SLURM_ARRAY_TASK_ID}p`)
####input_bam=(`cat list1 | sed -n ${SLURM_ARRAY_TASK_ID}p`)
base=$(basename ${input_bam} .aligned.duplicate_marked.sorted.bam)

## output: 
recalibration_report="$base.recal_data.csv"
output_bam="$base.aligned.duplicates_marked.recalibrated.bam"

srun gatk --java-options "-Xms55G -Djava.io.tmpdir=/scratch1/tanxinli/tmp/BaseRecalibrator" \
      BaseRecalibrator \
      -R $ref \
      -I /project/desmith_128/recordstudy/batch3/SortAndFixTags/$input_bam \
      --use-original-qualities \
      -O /project/desmith_128/recordstudy/batch3/bqsr.bam/$recalibration_report \
      --known-sites /project/desmith_488/tanxinli/refs/GATK_resource_bundle/Homo_sapiens_assembly38.dbsnp138.vcf \
      --known-sites /project/desmith_488/tanxinli/refs/GATK_resource_bundle/1000G_phase1.snps.high_confidence.hg38.vcf.gz \
      --known-sites  /project/desmith_488/tanxinli/refs/GATK_resource_bundle/Homo_sapiens_assembly38.known_indels.vcf.gz \
      --tmp-dir /scratch1/tanxinli/tmp/BaseRecalibrator
gatk --java-options "-Xms55G -Djava.io.tmpdir=/scratch1/tanxinli/tmp/BaseRecalibrator" \
      ApplyBQSR \
      -R $ref \
      -I /project/desmith_128/recordstudy/batch3/SortAndFixTags/$input_bam \
      -O /project/desmith_128/recordstudy/batch3/bqsr.bam/$output_bam \
      -bqsr /project/desmith_128/recordstudy/batch3/bqsr.bam/$recalibration_report \
      --static-quantized-quals 10 --static-quantized-quals 20 --static-quantized-quals 30 \
      --add-output-sam-program-record \
      --create-output-bam-md5 \
      --use-original-qualities \
      --tmp-dir /scratch1/tanxinli/tmp/BaseRecalibrator

