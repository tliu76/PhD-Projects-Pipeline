#!/bin/bash
#SBATCH --time=48:00:00
#SBATCH --mail-type=END
#SBATCH --output=/scratch1/tanxinli/output/1.1.2Tsortubam_%A_%a.out
#SBATCH --error=/scratch1/tanxinli/error/1.1.2Tsortubam_%A_%a.errcd
#SBATCH --job-name=1.1.2Tsortubam
#SBATCH -c 15
#SBATCH --ntasks=1
#SBATCH --mem=90G
#SBATCH --partition=epyc-64
#SBATCH --array=1-15
#SBATCH --account=desmith_488

set -e 
set -u 
set -x
set -o pipefail

cd /project/desmith_128/recordstudy/batch3/unmapped.bam
module load gcc/11.3.0
module load openjdk
module load gatk/4.2.6.1

# input 
input_bam=(`cat  unmappedname3 | sed -n ${SLURM_ARRAY_TASK_ID}p`)
base=$(basename ${input_bam} .unmapped.unsorted.bam)

# output 
sorted_bam_name="$base.sorted.unmapped.bam"
srun gatk --java-options "-Xms25G -Djava.io.tmpdir=/scratch1/tanxinli/tmp/sortubam" \
    SortSam \
    --INPUT /project/desmith_128/recordstudy/batch3/unmapped.bam/$input_bam \
    --OUTPUT  /scratch1/tanxinli/tumoroutput/batch3/sorted.unmapped.bam/$sorted_bam_name \
    --SORT_ORDER coordinate \
    --TMP_DIR /scratch1/tanxinli/tmp/sortubam

rm -rf $input_bam


