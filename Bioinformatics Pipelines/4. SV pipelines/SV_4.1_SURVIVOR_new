module load gcc/11.3.0 openblas/0.3.20
module load openjdk
module load gatk/4.2.6.1
module load bcftools/1.14
module load htslib 


cd /scratch1/tanxinli/tumoroutput/batch3sv/smoove.out/results_genotyped

# filter each vcf for lumpy
#only for 6 tumor-normal pairs 
for i in {1..6}
do
   echo "Welcome $i times"
## input:
input_vcf=(`ls *-smoove.genotyped.vcf.gz | sed -n ${i}p`)
base=$(basename ${input_vcf} -joint-smoove.genotyped.vcf.gz )
prefix="sample"
sample_name=${base#"$prefix"}
output_vcf="$sample_name.somaticSV.smoove.vcf.gz"
input_name="${sample_name}"
input_file="batch3.id"
# Use awk to find the matching name from the second column *tumor bam
matching_name=$(awk -v input="$input_name" '$1 == input {print $2}' "$input_file")
#check
if [ -n "$matching_name" ]; then
    echo "Matching name in the second column: $matching_name"
else
    echo "Name not found in the second column."
fi


bcftools view $input_vcf -Ou -i 'FMT/GT[1]=="0/0"' |\
bcftools view -Ou -i 'FMT/GT[0]=="0/1"||FMT/GT[0]=="1/1"'| \
bcftools view -s ^$matching_name  -o $output_vcf -O z --threads 15

done

