#!/bin/bash
#SBATCH --time=48:00:00
#SBATCH --mail-type=END
#SBATCH --output=/scratch1/tanxinli/output/2.2Cierco_%A_%a.out
#SBATCH --error=/scratch1/tanxinli/error/2.2Cierco_%A_%a.errcd
#SBATCH --job-name=2.2Cierco
#SBATCH -c 20
#SBATCH --ntasks=1
#SBATCH --mem=64G
#SBATCH --partition=main
#SBATCH --account=desmith_488
#SBATCH --array=2-21

module purge
module load gcc/11.3.0
module load samtools

cd /scratch1/tanxinli/rnaseq_out/MarkDup.sorted.bam/

input_bam=(`ls /scratch1/tanxinli/rnaseq_out/MarkDup.sorted.bam/*sorted.aligned.bam  | sed -n ${SLURM_ARRAY_TASK_ID}p`)
base=$(basename ${input_bam} .MarkDup.sorted.aligned.bam)

ref_Cierco="/project/desmith_488/tanxinli/Cierco/reference_hg38/reference/"
input_junctions="/scratch1/tanxinli/rnaseq_out/RNApeg/${base}.MarkDup.sorted.aligned.bam.junctions.tab.shifted.tab"

#input_bam_bai="/scratch1/tanxinli/rnaseq_out/MarkDup.sorted.bam/${base}.MarkDup.sorted.aligned.bam.bai"
#samtools index $input_bam  $input_bam_bai

output="/scratch1/tanxinli/rnaseq_out/Cierco/${base}.Cierco"

singularity exec --bind /project/desmith_488/tanxinli/,/scratch1/tanxinli/,/project/desmith_128/recordstudy/rna_seq/ /project/desmith_488/tanxinli/SINGULARITY_CACHEDIR/mdall/mdall/cicero_0.3.0p2.sif \
Cicero.sh -n 8 -b $input_bam -g GRCh38_no_alt -r $ref_Cierco -j $input_junctions -s 2 -c 10 -o $output



#It is recommended to use the full path for all input files. The input.junctions file will be the .bam.junctions.tab.shifted.tab file generated by RNApeg.