#SBATCH --error=/scratch1/tanxinli/error/2.1T_manta_%A_%a.errcd
#SBATCH --job-name=2.1Tumor_manta
#SBATCH --cpus-per-task 4
#SBATCH --ntasks=1
#SBATCH --mem=5G
#SBATCH --partition=main
#SBATCH --array=1-6


module purge
eval "$(conda shell.bash hook)"
conda activate /home1/tanxinli/miniconda3/envs/manta

#srun hostname
#export PATH="/project/desmith_488/kerenxu/SINGULARITY_CACHEDIR/:$PATH"

cd  /scratch1/tanxinli/tumoroutput/batch2/bqsr.bam
tumor_dir="/project/desmith_128/recordstudy/batch3/bqsr.bam"
normal_dir="/project/desmith_128/recordstudy/batch3/bqsr.bam"
ref=/project/desmith_488/tanxinli/refs/GATK_resource_bundle/resources_broad_hg38_v0_Homo_sapiens_assembly38.fasta
exclude_bed=/project/desmith_488/tanxinli/refs/SV_resource/exclude.cnvnator_100bp.GRCh38.20170403.bed
threads=4

## input:
cd  /project/desmith_128/recordstudy/batch3/bqsr.bam
#normal_bam=(`ls L00*.aligned.duplicates_marked.recalibrated.bam | sed -n ${SLURM_ARRAY_TASK_ID}p`)
#base=$(basename ${normal_bam} .aligned.duplicates_marked.recalibrated.bam)

base=(`awk '{print $1}' batch3.id | sed -n ${SLURM_ARRAY_TASK_ID}p`)
normal_bam="${base}.aligned.duplicates_marked.recalibrated.bam"

sample_name=${base}
cd /project/desmith_128/recordstudy/batch3/bqsr.bam
input_name="${sample_name}"
input_file="batch3.id"

# Use awk to find the matching name from the second column
matching_name=$(awk -v input="$input_name" '$1 == input {print $2}' "$input_file")
tumor_bam="${matching_name}.aligned.duplicates_marked.recalibrated.bam"


configManta.py \
    --referenceFasta=$ref \
    --runDir=/scratch1/tanxinli/tumoroutput/batch3sv/manta.config/$matching_name \
    --normalBam=$normal_dir/$normal_bam \
    --tumorBam=$tumor_dir/$tumor_bam
