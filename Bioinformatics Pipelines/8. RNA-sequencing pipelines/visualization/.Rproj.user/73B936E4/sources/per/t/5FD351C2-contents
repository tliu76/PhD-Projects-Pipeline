##combined results from HTseq count

```{r, echo=FALSE}
all_paths.HTSeq <- list.files(path = "./HTSeq", pattern = "*.DUX4patched.HTSeq",full.names = TRUE)
library(dplyr)
# read file content
# Define a function to read the file and filter the rows
process_file <- function(file) {
  # Read the file
  data <- fread(file)

  # Filter rows where column A starts with "ENSG"
  filtered_data <- data[grepl("^ENSG", V1)]

  return(filtered_data)
}

# Use lapply to process each file and return the filtered data in a list
all_content.HTSeq <- lapply(all_paths.HTSeq, process_file)

```


