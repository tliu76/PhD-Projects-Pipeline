),
hjust = 1.1, vjust = 1.1,
size = 4
)
ggplot(prs_merge , aes(x = SCORE1_AVG, y = standardized_PRS_MP2PRT_only)) +
geom_point(alpha = 0.6) +
geom_smooth(method = "lm", color = "red") +
theme_bw() +
labs(
title = "Correlation Between Two PRS",
x = "PRS: SCORE1_AVG",
y = "PRS: standardized_PRS_MP2PRT_only"
)+
annotate(
"text",
x = 0, y = Inf,
label = paste0(
"r = ", round(r_val, 3),
"\nP = ", format.pval(p_val, digits = 3)
),
hjust = 1.1, vjust = 1.1,
size = 4
)
ggplot(prs_merge, aes(x = SCORE1_AVG, y = standardized_PRS_MP2PRT_only)) +
geom_point(alpha = 0.6) +
geom_smooth(method = "lm", color = "red") +
stat_cor(method = "pearson", label.x.npc = "left", label.y.npc = "top") +
theme_bw() +
labs(
title = "Correlation Between Two PRS",
x = "PRS: SCORE1_AVG",
y = "PRS: standardized_PRS_MP2PRT_only"
)
