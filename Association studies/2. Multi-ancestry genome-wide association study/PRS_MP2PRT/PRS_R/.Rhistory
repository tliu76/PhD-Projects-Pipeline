plot_density <- function(prs_blood_merge, raw_col, std_col, group_name) {
ggplot(df) +
geom_density(aes(x = .data[[raw_col]], color = "My PRS"), size = 1) +
geom_density(aes(x = .data[[std_col]], color = "Standardized PRS"), size = 1) +
theme_bw() +
labs(
title = paste0(group_name, " PRS Density"),
x = "PRS value",
y = "Density",
color = ""
)
}
